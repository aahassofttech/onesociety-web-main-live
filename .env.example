# MySQL connection for the lead-capture API (src/lib/db.ts).
# Copy to .env.local and fill in real values — never commit real credentials.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Alternatively, set the parts individually instead of DATABASE_URL:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
